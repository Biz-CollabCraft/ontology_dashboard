# Backend System Environment Configuration Example
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Versioned Model Artifact provider. Never point this at a sibling generator
# relative path such as ../generator/.... Local path, mounted volume, object
# storage or an artifact-registry adapter may be injected per deployment.
MODEL_ARTIFACT_URI=/var/lib/ontology-dashboard/model-artifacts

# local/demo/test allow the heuristic fallback by default when this variable is
# omitted. development/dev/deploy/staging/production fail closed without a
# Model Artifact unless fallback is explicitly enabled for a specific run.
ONTOLOGY_DASHBOARD_ALLOW_HEURISTIC_MODEL_FALLBACK=0
