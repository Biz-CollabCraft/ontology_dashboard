# The Backend consumes a versioned Model Artifact through an injected URI.
# Never point this at a sibling generator-relative path such as ../generator/...
MODEL_ARTIFACT_URI=

# Week 2 local/demo compatibility only. Production should set this to 0 and
# inject MODEL_ARTIFACT_URI.
ONTOLOGY_DASHBOARD_ALLOW_HEURISTIC_MODEL_FALLBACK=1

