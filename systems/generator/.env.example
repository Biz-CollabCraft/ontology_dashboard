# Generator System Environment Configuration Example
# The Generator LLM client reads OPENAI_API_KEY directly. Never commit a real key.
OPENAI_API_KEY=
GENERATOR_LLM_PROVIDER=openai
GENERATOR_LLM_MODEL=gpt-4o-mini
# Alternative provider for a Google Cloud / Vertex AI project.
# GENERATOR_LLM_PROVIDER=vertex_ai
# GENERATOR_LLM_MODEL=gemini-3.5-flash
VERTEX_AI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Runtime/persistence paths are injected by the deployment. They deliberately do
# not point at a sibling backend implementation directory.
DATA_DIR=/data/source
DATA_PREPROCESSED_DIR=/data/preprocessed
ONTOLOGY_DIR=/data/ontology
MODELS_STORE_DIR=/data/models
MODEL_ARTIFACT_URI=/artifacts
GEN_DATA_OUTPUT_DIR=
GENERATOR_TRAINING_N_JOBS=2
LOG_LEVEL=INFO

# Backend Prediction Result Inbox delivery.
GENERATOR_PREDICTION_RESULT_URL=http://localhost:8000/internal/prediction-results
GENERATOR_PREDICTION_RESULT_PROJECT_ID=manufacturing-demo-project
GENERATOR_PREDICTION_RESULT_WORKSPACE_ID=manufacturing-demo
GENERATOR_PREDICTION_RESULT_TOKEN=
