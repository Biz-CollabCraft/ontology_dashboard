{
  "eval_set_id": "agent-review-packet-gold-v1",
  "purpose": "pre_llm_release_gate",
  "description": "Eight gold fixtures for the read-only Agent Review Packet before 8x15 LLM summarization. The set covers normal, warning, critical, low-confidence, data-quality hold, SOP present/absent, source-ref grounding, and closed-loop mutation boundaries.",
  "owner_domain": "product_evidence",
  "packet_schema_version": "agent-review-packet-v1.0",
  "summary_schema_version": "agent-review-summary-v1.0",
  "case_selection_policy": {
    "minimum_cases": 8,
    "selection_basis": [
      "all GS-001..GS-008 core manufacturing fixtures are represented as Agent Review Packet gold files",
      "normal, attention, warning, critical, and data-quality hold states are included",
      "SOP-present and SOP-absent paths are both included",
      "closed-loop available actions remain read-only context, not executable AI authority",
      "one provider-offline fixture separates LLM availability/fallback from product evidence gaps"
    ],
    "non_goals": [
      "large-scale model benchmarking",
      "LLM-as-judge scoring",
      "production RAG retrieval metric scoring",
      "production LangGraph watcher migration"
    ]
  },
  "required_coverage": [
    "closed_loop_available_action_readonly",
    "closed_loop_boundary_readonly",
    "continue_monitoring",
    "data_quality_hold",
    "data_quality_hold_review_draft",
    "evidence_gap_completeness",
    "factor_bundle_to_single_inspection_target",
    "field_location_present",
    "heat_dissipation_warning",
    "history_review_items_present",
    "inspection_focus_completeness",
    "llm_offline_fixture",
    "low_confidence_attention",
    "multi_factor_warning",
    "multiple_inspection_targets",
    "no_inspection_target",
    "normal_stable",
    "sop_guidance_absent",
    "sop_guidance_present",
    "summary_natural_language_grounding",
    "summary_structured_grounding",
    "target_source_refs_grounded"
  ],
  "cases": [
    {
      "scenario_id": "GS-001",
      "asset_id": "CNC-S01-L01-01",
      "fixture_path": "tests/fixtures/agent_review_packets/GS-001.json",
      "description": "Normal/stable case that should stay low-priority and continue monitoring while preserving model-expression source refs.",
      "covers": [
        "normal_stable",
        "continue_monitoring",
        "sop_guidance_absent",
        "field_location_present",
        "summary_structured_grounding",
        "evidence_gap_completeness",
