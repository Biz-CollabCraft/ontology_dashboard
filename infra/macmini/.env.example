# Host paths / local ports
ONTOLOGY_DATA_ROOT=/Users/your-user/services/ontology-dashboard-data
BACKEND_PORT=8110
FRONTEND_PORT=8120

# PostgreSQL. Real credentials live only in the Mac mini .env (chmod 600).
POSTGRES_DB=ontology_dashboard
POSTGRES_USER=ontology
POSTGRES_PASSWORD=
ONTOLOGY_DASHBOARD_DATABASE_URL=postgresql://ontology:CHANGE_ME@postgres:5432/ontology_dashboard

# Frontend origins. Keep this narrow; do not use '*'.
ONTOLOGY_DASHBOARD_ALLOWED_ORIGINS=https://biz-collabcraft-ontology-dashboard.vercel.app
ONTOLOGY_DASHBOARD_ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Model Artifact boundary. Backend reads; Generator publishes.
BACKEND_MODEL_ARTIFACT_URI=/artifacts/compressor-failure-risk/current
BACKEND_CNC_MODEL_ARTIFACT_URI=/artifacts/cnc-failure-risk/current
GENERATOR_TRAINING_N_JOBS=2
OPENAI_API_KEY=
GENERATOR_LLM_PROVIDER=openai
GENERATOR_LLM_MODEL=gpt-4o-mini
VERTEX_AI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Backend LLM variables are independent from Generator OPENAI_API_KEY.
LLM_PROVIDER=deterministic
LLM_MODEL=
LLM_API_KEY=
MAINTENANCE_CONTEXT_PROVIDER=fixture
SEED_DEMO_ACCOUNTS=0
ONTOLOGY_DASHBOARD_SEED_REFERENCE_DATA=false
ONTOLOGY_DASHBOARD_ALLOW_HEURISTIC_MODEL_FALLBACK=0
