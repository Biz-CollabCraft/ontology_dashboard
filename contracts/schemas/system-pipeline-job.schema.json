{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/system-pipeline-job.schema.json",
  "title": "System Pipeline Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "job_type", "status", "request_id", "idempotency_key", "run_id", "mapping_id", "mapping_version", "mapping_sha256", "source_uri", "replay_scope", "activate_on_success", "progress", "retry_count", "cancel_requested", "created_by", "created_at"],
  "properties": {
    "job_id": {"type": "string", "format": "uuid"},
    "job_type": {"const": "mapping_rebuild"},
    "status": {"enum": ["queued", "running", "checkpointed", "cancel_requested", "succeeded", "failed", "cancelled"]},
    "request_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "format": "uuid"},
    "mapping_id": {"type": "string", "minLength": 1},
    "mapping_version": {"type": "string", "minLength": 1},
    "mapping_sha256": {"type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$"},
    "source_uri": {"type": "string", "minLength": 1},
    "source_identity": {"type": ["string", "null"]},
    "replay_scope": {"const": "full_source"},
    "activate_on_success": {"type": "boolean"},
    "progress": {"type": "object"},
    "checkpoint": {"type": ["object", "null"]},
    "result": {"type": ["object", "null"]},
    "error": {"type": ["object", "null"]},
    "retry_count": {"type": "integer", "minimum": 0},
    "cancel_requested": {"type": "boolean"},
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "heartbeat_at": {"type": ["string", "null"], "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
