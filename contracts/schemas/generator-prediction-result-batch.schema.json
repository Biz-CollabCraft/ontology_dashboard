{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/generator-prediction-result-batch.schema.json",
  "title": "GeneratorPredictionResultBatch",
  "type": "object",
  "required": [
    "event_id",
    "run_id",
    "job_id",
    "asset_id",
    "observed_at",
    "generated_at",
    "dataset_id",
    "dataset_version",
    "model_results",
    "source_lineage"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "model_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "model_id",
          "model_version",
          "status"
        ],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "model_id": { "type": "string", "minLength": 1 },
          "model_version": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["succeeded", "failed", "unknown"] },
          "score_type": { "type": ["string", "null"] },
          "score": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
          "artifact_ref": {
            "type": ["object", "null"],
            "properties": {
              "uri": { "type": "string" },
              "sha256": { "type": "string" },
              "role": { "type": "string" }
            }
          },
          "feature_ref": {
            "type": ["object", "null"],
            "properties": {
              "uri": { "type": "string" },
              "sha256": { "type": "string" },
              "role": { "type": "string" }
            }
          },
          "error_code": { "type": ["string", "null"] },
          "error_message": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "source_lineage": {
      "type": "object",
      "required": ["source_uri", "source_checksum"],
      "properties": {
        "source_uri": { "type": "string" },
        "source_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pipeline_contract_version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sensor_data_ref": {
      "type": ["object", "null"],
      "properties": {
        "uri": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "feature_ref": {
      "type": ["object", "null"],
      "properties": {
        "uri": { "type": "string" },
        "sha256": { "type": "string" },
        "role": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
