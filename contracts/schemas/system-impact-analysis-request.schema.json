{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/system-impact-analysis-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["include_stages"],
  "properties": {
    "mapping_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "mapping_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "mapping_sha256": {"type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$"},
    "rebuild_job_id": {"type": "string", "format": "uuid"},
    "source_asset_type": {"enum": ["preprocessing_plan", "feature_schema", "label_schema", "history_requirement", "training_config"]},
    "source_asset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "source_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "source_sha256": {"type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$"},
    "source_job_id": {"type": ["string", "null"]},
    "include_stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["preprocessing", "feature", "training"]}}
  },
  "oneOf": [
    {"required": ["mapping_id", "mapping_version", "mapping_sha256", "rebuild_job_id"], "not": {"required": ["source_asset_type"]}},
    {"required": ["source_asset_type", "source_asset_id", "source_version", "source_sha256"], "not": {"required": ["mapping_id"]}}
  ]
}
