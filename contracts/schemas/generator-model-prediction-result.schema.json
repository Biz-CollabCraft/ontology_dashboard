{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/generator-model-prediction-result.schema.json",
  "title": "GeneratorModelPredictionResult",
  "type": "object",
  "required": [
    "asset_id",
    "model_id",
    "model_version",
    "status"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "failed", "unknown"]
    },
    "score_type": {
      "type": ["string", "null"]
    },
    "score": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "artifact_ref": {
      "type": ["object", "null"],
      "properties": {
        "uri": { "type": "string" },
        "sha256": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "feature_ref": {
      "type": ["object", "null"],
      "properties": {
        "uri": { "type": "string" },
        "sha256": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "error_code": {
      "type": ["string", "null"]
    },
    "error_message": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
