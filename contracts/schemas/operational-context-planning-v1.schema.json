{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operational-context-planning-v1",
  "type": "object",
  "description": "Optional production-planning context composed by Backend. It is not an Evidence/Product Result input and must not change risk, status_grade, top_factors, or recommended_action.",
  "additionalProperties": false,
  "properties": {
    "load_level": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "low",
        "normal",
        "high",
        null
      ]
    },
    "runtime_hours_7d": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "production_impact": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        null
      ]
    },
    "context_id": {
      "type": "string"
    },
    "source_type": {
      "const": "capacity_model"
    },
    "temporal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "timezone",
        "valid_from",
        "valid_to",
        "generated_at"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "type": "string",
          "format": "date-time"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "production_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "plan_date",
        "planned_units",
        "product_mix"
      ],
      "properties": {
        "plan_id": {
          "type": "string"
        },
        "plan_date": {
          "type": "string",
          "format": "date"
        },
        "planned_units": {
          "type": "integer",
          "minimum": 0
        },
        "product_mix": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "variant",
              "share",
              "planned_units"
            ],
            "properties": {
              "variant": {
                "type": "string"
              },
              "share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "planned_units": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "capacity_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_asset_count",
        "planned_operating_hours",
        "oee",
        "standard_cycle_minutes_per_unit",
        "asset_units_per_hour",
        "daily_capacity_units",
        "basis"
      ],
      "properties": {
        "active_asset_count": {
          "type": "integer",
          "minimum": 1
        },
        "planned_operating_hours": {
          "type": "number",
          "minimum": 0
        },
        "oee": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "standard_cycle_minutes_per_unit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "asset_units_per_hour": {
          "type": "number",
          "minimum": 0
        },
        "daily_capacity_units": {
          "type": "integer",
          "minimum": 0
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "event_impact": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "event_id",
        "equipment_id",
        "line",
        "product_variant",
        "screen_priority",
        "impact_status",
        "estimated_lost_units",
        "basis"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "equipment_id": {
          "type": "string"
        },
        "line": {
          "type": "string"
        },
        "product_variant": {
          "type": "string"
        },
        "screen_priority": {
          "enum": [
            "none",
            "monitor",
            "shift_inspection",
            "plan_at_risk",
            "data_check_required"
          ]
        },
        "impact_status": {
          "enum": [
            "not_applicable",
            "estimated",
            "withheld_data_quality_hold"
          ]
        },
        "estimated_lost_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "estimated_downtime_minutes",
            "asset_units_per_hour",
            "formula"
          ],
          "properties": {
            "estimated_downtime_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "asset_units_per_hour": {
              "type": "number",
              "minimum": 0
            },
            "formula": {
              "type": "string"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "load_level",
        "runtime_hours_7d",
        "production_impact"
      ]
    },
    {
      "required": [
        "context_id",
        "source_type",
        "temporal_scope",
        "production_plan",
        "capacity_model",
        "event_impact",
        "limitations"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "source_type"
        ]
      },
      "then": {
        "required": [
          "context_id",
          "source_type",
          "temporal_scope",
          "production_plan",
          "capacity_model",
          "event_impact",
          "limitations"
        ]
      }
    }
  ]
}
