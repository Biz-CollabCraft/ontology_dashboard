{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/prediction-result-batch.schema.json",
  "title": "Generator to Backend Prediction Result Batch Contract",
  "description": "Raw upstream prediction handoff from Generator Runtime to Backend Prediction Inbox. This is not Product Result Artifact or Event Evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "batch_id",
    "producer",
    "emitted_at",
    "results"
  ],
  "properties": {
    "contract_version": {"const": "prediction-result-batch-v1"},
    "batch_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "runtime_version"],
      "properties": {
        "system": {"const": "systems.generator"},
        "runtime_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "outbox_id": {"type": ["string", "null"], "maxLength": 240}
      }
    },
    "emitted_at": {"type": "string", "format": "date-time"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/prediction_result_batch_item"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "non_empty_string": {"type": "string", "minLength": 1, "maxLength": 240},
    "source_kind": {
      "type": "string",
      "enum": ["live_sensor", "simulation_overlay", "maintenance_replay"]
    },
    "output_status": {
      "type": "string",
      "enum": [
        "predicted",
        "warming_up",
        "history_insufficient",
        "failed_source_unavailable",
        "failed_model_artifact",
        "failed_feature_execution",
        "failed_model_inference",
        "failed_delivery"
      ]
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "minLength": 1, "maxLength": 1000},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulation_session_id",
        "overlay_branch_id",
        "history_segment_id",
        "maintenance_event_id",
        "maintenance_action_id",
        "state_version"
      ],
      "properties": {
        "simulation_session_id": {"type": ["string", "null"], "maxLength": 240},
        "overlay_branch_id": {"type": ["string", "null"], "maxLength": 240},
        "history_segment_id": {"type": ["string", "null"], "maxLength": 240},
        "maintenance_event_id": {"type": ["string", "null"], "maxLength": 240},
        "maintenance_action_id": {"type": ["string", "null"], "maxLength": 240},
        "state_version": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "prediction_result_batch_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "asset_id",
        "observed_at",
        "source_kind",
        "source_ref",
        "payload_sha256",
        "output_status",
        "score",
        "model_id",
        "model_version",
        "model_artifact_sha256",
        "feature_schema_version",
        "history_requirement_version",
        "lineage"
      ],
      "properties": {
        "event_id": {"$ref": "#/$defs/non_empty_string"},
        "asset_id": {"$ref": "#/$defs/non_empty_string"},
        "observed_at": {"type": "string", "format": "date-time"},
        "source_kind": {"$ref": "#/$defs/source_kind"},
        "source_ref": {"$ref": "#/$defs/source_ref"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "output_status": {"$ref": "#/$defs/output_status"},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "model_id": {"$ref": "#/$defs/non_empty_string"},
        "model_version": {"$ref": "#/$defs/non_empty_string"},
        "model_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "feature_schema_version": {"$ref": "#/$defs/non_empty_string"},
        "history_requirement_version": {"$ref": "#/$defs/non_empty_string"},
        "feature_schema_sha256": {"$ref": "#/$defs/sha256"},
        "history_requirement_sha256": {"$ref": "#/$defs/sha256"},
        "lineage": {"$ref": "#/$defs/lineage"},
        "failure_reason": {"type": ["string", "null"], "maxLength": 1000}
      },
      "allOf": [
        {
          "if": {"properties": {"output_status": {"const": "predicted"}}},
          "then": {
            "properties": {
              "score": {"type": "number", "minimum": 0, "maximum": 1},
              "failure_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"output_status": {"not": {"const": "predicted"}}}},
          "then": {
            "properties": {
              "score": {"type": "null"},
              "failure_reason": {"type": "string", "minLength": 1, "maxLength": 1000}
            }
          }
        },
        {
          "if": {"properties": {"source_kind": {"const": "maintenance_replay"}}},
          "then": {
            "properties": {
              "lineage": {
                "required": [
                  "simulation_session_id",
                  "overlay_branch_id",
                  "history_segment_id",
                  "maintenance_event_id",
                  "maintenance_action_id",
                  "state_version"
                ],
                "properties": {
                  "simulation_session_id": {"type": "string", "minLength": 1, "maxLength": 240},
                  "overlay_branch_id": {"type": "string", "minLength": 1, "maxLength": 240},
                  "history_segment_id": {"type": "string", "minLength": 1, "maxLength": 240},
                  "maintenance_event_id": {"type": "string", "minLength": 1, "maxLength": 240},
                  "maintenance_action_id": {"type": "string", "minLength": 1, "maxLength": 240},
                  "state_version": {"type": "integer", "minimum": 1}
                }
              }
            }
          }
        }
      ]
    }
  }
}
