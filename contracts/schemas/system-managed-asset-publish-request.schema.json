{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/system-managed-asset-publish-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["expected_revision", "expected_payload_sha256", "reason"],
  "properties": {
    "expected_revision": {"type": "integer", "minimum": 1},
    "expected_payload_sha256": {"type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
