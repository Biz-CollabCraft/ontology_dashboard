{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/generator-anomaly-signal.schema.json",
  "title": "GeneratorAnomalySignal",
  "type": "object",
  "required": [
    "event_id",
    "run_id",
    "job_id",
    "asset_id",
    "detected_at",
    "dataset_id",
    "dataset_version",
    "anomaly_detected",
    "anomaly_models",
    "model_results",
    "source_lineage"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "anomaly_detected": {
      "type": "boolean"
    },
    "anomaly_models": {
      "type": "array",
      "items": { "type": "string" }
    },
    "model_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "model_id",
          "model_version",
          "status",
          "prediction",
          "threshold",
          "predicted_at"
        ],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "model_id": { "type": "string" },
          "model_version": { "type": "string" },
          "status": { "type": "string", "enum": ["succeeded", "failed", "unknown"] },
          "prediction": { "type": "string", "enum": ["normal", "anomaly", "unknown", "failed"] },
          "probability": { "type": ["number", "null"] },
          "threshold": { "type": "number" },
          "is_anomaly": { "type": ["boolean", "null"] },
          "predicted_at": { "type": "string", "format": "date-time" },
          "artifact_ref": { "type": ["object", "null"] },
          "feature_ref": { "type": ["object", "null"] },
          "error_code": { "type": ["string", "null"] },
          "error_message": { "type": ["string", "null"] }
        }
      },
      "minItems": 1
    },
    "source_lineage": {
      "type": "object",
      "required": ["source_uri", "source_checksum"],
      "properties": {
        "source_uri": { "type": "string" },
        "source_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pipeline_contract_version": { "type": "string" }
      }
    },
    "sensor_data_ref": {
      "type": ["object", "null"],
      "properties": {
        "uri": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "feature_ref": {
      "type": ["object", "null"],
      "properties": {
        "uri": { "type": "string" },
        "sha256": { "type": "string" },
        "role": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
