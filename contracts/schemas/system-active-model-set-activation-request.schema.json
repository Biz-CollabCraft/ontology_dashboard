{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/system-active-model-set-activation-request.schema.json",
  "title": "System Active Model Set Activation Request",
  "type": "object",
  "required": ["model_set_id", "model_set_version", "models", "reason"],
  "properties": {
    "model_set_id": {"type": "string", "minLength": 1},
    "model_set_version": {"type": "string", "minLength": 1},
    "models": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["model_id", "required"], "properties": {"model_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}, "model_version": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._-]+$"}, "required": {"type": "boolean"}}, "additionalProperties": false}},
    "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
  },
  "additionalProperties": false
}
